---
import EvidenceExplorer from "../../components/EvidenceExplorer";
import profile from "../../../profiles/daniel.json";
import type { ResumilioProfile } from "../../profile";
import { absoluteUrl } from "../../site";
import { buildProfileJsonLd } from "../../structured-data";
import "../../styles/global.css";

const publicProfile = profile as ResumilioProfile;
const canonical = absoluteUrl("/es/");
const alternate = absoluteUrl("/");
const jsonLd = buildProfileJsonLd(publicProfile, "es");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Daniel Rosales — ingeniero de integraciones y automatización con experiencia en CRM, sistemas backend, APIs y automatización práctica." />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternate} />
    <link rel="alternate" hreflang="x-default" href={alternate} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Daniel Rosales" />
    <meta property="og:title" content="Daniel Rosales — Ingeniero de Integraciones y Automatización" />
    <meta property="og:description" content="Integraciones CRM, sistemas backend, APIs y automatización práctica para equipos y flujos de clientes reales." />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Daniel Rosales — Ingeniero de Integraciones y Automatización" />
    <meta name="twitter:description" content="Integraciones CRM, sistemas backend, APIs y automatización práctica para equipos y flujos de clientes reales." />
    <title>Daniel Rosales — Ingeniero de Integraciones y Automatización</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <EvidenceExplorer profile={publicProfile} initialLocale="es" client:idle />
  </body>
</html>
