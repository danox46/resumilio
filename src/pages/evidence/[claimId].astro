---
import EvidenceRecord from "../../components/EvidenceRecord.astro";
import profileDocument from "../../../profiles/daniel.json";
import type { ResumilioProfile } from "../../profile";

export function getStaticPaths() {
  return (profileDocument as ResumilioProfile).claims.map((claim) => ({ params: { claimId: claim.id }, props: { claim } }));
}
const profile = profileDocument as ResumilioProfile;
const { claim } = Astro.props;
---
<EvidenceRecord profile={profile} claim={claim} locale="en" />
