---
import EvidenceExplorer from "../components/EvidenceExplorer";
import profile from "../../profiles/daniel.json";
import type { ResumilioProfile } from "../profile";
import { absoluteUrl } from "../site";
import { buildProfileJsonLd } from "../structured-data";
import "../styles/global.css";

const publicProfile = profile as ResumilioProfile;
const canonical = absoluteUrl("/");
const alternate = absoluteUrl("/es/");
const jsonLd = buildProfileJsonLd(publicProfile, "en");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Daniel Rosales — integration and automation engineer working across CRM platforms, backend systems, APIs, and practical automation." />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternate} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Daniel Rosales" />
    <meta property="og:title" content="Daniel Rosales — Integration & Automation Engineer" />
    <meta property="og:description" content="CRM integrations, backend systems, APIs, and practical automation for real teams and client workflows." />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_CO" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Daniel Rosales — Integration & Automation Engineer" />
    <meta name="twitter:description" content="CRM integrations, backend systems, APIs, and practical automation for real teams and client workflows." />
    <title>Daniel Rosales — Integration & Automation Engineer</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <EvidenceExplorer profile={publicProfile} initialLocale="en" client:idle />
  </body>
</html>
