---
const { locale = "en" } = Astro.props;
const es = locale === "es";
---
<nav class="site-nav" aria-label={es ? "Navegación principal" : "Primary navigation"}>
  <a class="wordmark" href={es ? "/es/" : "/"}>
    <svg class="brand-mark" viewBox="0 0 44 44" aria-hidden="true">
      <path class="brand-mark-line brand-mark-line--spine" d="M8 9 7 32M34 8 37 30" />
      <path class="brand-mark-taper" d="M7.29 10.03 20.74 18.37 21.26 17.63 8.71 7.97Z" />
      <path class="brand-mark-taper" d="M33.24 7.01 20.73 17.64 21.27 18.36 34.76 8.99Z" />
      <path class="brand-mark-taper" d="M6.92 33.25 22.97 33.45 23.03 32.55 7.08 30.75Z" />
      <path class="brand-mark-taper" d="M36.74 28.78 22.91 32.56 23.09 33.44 37.26 31.22Z" />
      <path class="brand-mark-line brand-mark-line--fold" d="M21 18 23 33" />
      <circle cx="8" cy="9" r="3" /><circle cx="21" cy="18" r="4" /><circle cx="34" cy="8" r="3" />
      <circle cx="7" cy="32" r="3" /><circle cx="23" cy="33" r="3" /><circle cx="37" cy="30" r="3" />
    </svg>
    <span>resumilio</span>
  </a>
  <div class="site-nav-links">
    <a href={es ? "/es/demo/" : "/demo/"}>{es ? "Demo" : "Demo"}</a>
    <a href={es ? "/es/como-usar/" : "/how-to/"}>{es ? "Cómo funciona" : "How it works"}</a>
    <a href="https://github.com/danox46/resumilio">GitHub</a>
    <a href={es ? "/" : "/es/"}>{es ? "EN" : "ES"}</a>
  </div>
</nav>
