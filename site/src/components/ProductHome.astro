---
import Nav from "./Nav.astro";
import { Constellation } from "../../../ui/Constellation";
import profileDocument from "../../../profiles/demo.json";
import configDocument from "../../../resumilio.config.json";
import type { ResumilioConfig, ResumilioProfile } from "../../../core/profile";
const { locale = "en" } = Astro.props;
const es = locale === "es";
const profile = profileDocument as ResumilioProfile;
const config = configDocument as ResumilioConfig;
---
<div class="site-shell">
  <Nav locale={locale} />
  <main>
    <section class="hero">
      <div class="hero-copy">
        <h1>{es ? <>Tu carrera,<br/><em>en movimiento.</em></> : <>Your career,<br/><em>in motion.</em></>}</h1>
        <p>{es ? "Un currículum vivo que se adapta a lo que las personas exploran." : "A living resume that adapts to what people explore."}</p>
        <div class="install-command">npx resumilio@latest init my-resume</div>
        <a class="primary-link" href={es ? "/es/demo/" : "/demo/"}>{es ? "Probar la demo ficticia →" : "Try the fictional demo →"}</a>
        <p class="hero-note">{es ? "Explora un currículum interactivo. Ninguna persona real. Completamente ficticio." : "Explore an interactive resume. No real person. Fully fictional."}</p>
      </div>
      <div class="hero-demo"><Constellation profile={profile} config={config} locale={locale} classicBase={es ? "/es/classic/" : "/classic/"} client:load /></div>
    </section>
    <section class="feature-band" id="how-it-works" aria-labelledby="feature-heading">
      <div class="feature-band-heading">
        <p class="feature-eyebrow">{es ? "Lo que Resumilio te ofrece" : "What Resumilio gives you"}</p>
        <h2 id="feature-heading">{es ? "Una carrera. Más formas de entenderla." : "One career. More ways to understand it."}</h2>
      </div>
      <article class="feature">
        <span class="feature-number" aria-hidden="true">01</span>
        <h3>{es ? "Una nueva experiencia visual" : "A new visual experience"}</h3>
        <p>{es ? "Explora roles, proyectos y momentos clave como una constelación conectada que revela la forma de tu trabajo." : "Explore roles, projects, and career highlights as a connected constellation that reveals the shape of your work."}</p>
      </article>
      <article class="feature">
        <span class="feature-number" aria-hidden="true">02</span>
        <h3>{es ? "Una hoja de vida clásica, lista" : "A classic resume, ready"}</h3>
        <p>{es ? "Conserva una versión familiar y lista para aplicar junto al perfil visual, sin mantener dos historias." : "Keep a familiar, application-ready version beside the visual profile—without maintaining two stories."}</p>
      </article>
      <article class="feature">
        <span class="feature-number" aria-hidden="true">03</span>
        <h3>{es ? "Recomendaciones que reaccionan" : "Recommendations that react"}</h3>
        <p>{es ? "A medida que alguien explora, Resumilio destaca el trabajo conectado más relevante y abre nuevas rutas por tu trayectoria." : "As someone explores, Resumilio brings relevant connected work forward and opens new paths through your career."}</p>
      </article>
    </section>
  </main>
  <footer class="site-footer"><span>Resumilio · MIT</span><span>{es ? "Tu carrera, en movimiento." : "Your career, in motion."}</span></footer>
</div>
