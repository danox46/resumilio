---
import Base from "../../../layouts/Base.astro";
import Nav from "../../../components/Nav.astro";
import { Constellation } from "../../../../../ui/Constellation";
import profile from "../../../../../profiles/demo.json";
import config from "../../../../../resumilio.config.json";
import type { ResumilioConfig, ResumilioProfile } from "../../../../../core/profile";
const typedProfile = profile as ResumilioProfile;
const typedConfig = config as ResumilioConfig;
---
<Base locale="es" title="Demo ficticia de Resumilio" description="Explora una constelación profesional interactiva y completamente ficticia."><div class="site-shell"><Nav locale="es"/><main style="min-height:calc(100vh - 76px);padding:20px clamp(12px,3vw,44px)"><p class="demo-disclosure"><strong>Demo ficticia</strong> — cada persona, organización y elemento profesional de esta página es inventado.</p><Constellation profile={typedProfile} config={typedConfig} locale="es" classicBase="/es/classic/" client:load /></main></div></Base>
