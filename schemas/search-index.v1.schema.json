{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danox46/resumilio/blob/main/schemas/search-index.v1.schema.json",
  "title": "Resumilio localized search index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "locale", "canonicalUrl", "documents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "resumilio-search-index" },
    "locale": { "enum": ["en", "es"] },
    "canonicalUrl": { "$ref": "#/$defs/url" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "type", "lifecycle", "tags", "evidence", "url"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "lifecycle": { "type": "string" },
          "tags": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "organization": { "type": "string" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
  }
}
