---
import "../styles/global.css";
interface Props { title: string; description: string; locale?: string; }
const { title, description, locale = "en" } = Astro.props;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title}</title></head><body><slot/></body></html>
